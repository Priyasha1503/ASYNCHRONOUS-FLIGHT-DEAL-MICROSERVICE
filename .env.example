# Copy to .env and adjust. Placeholders only — never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-value

# Host-side URLs (docker-compose overrides these for containers)
DATABASE_URL=postgresql+psycopg://skyscout:skyscout@127.0.0.1:5432/skyscout
REDIS_URL=redis://127.0.0.1:6379/0
# Test suite only — must point at a disposable database
TEST_DATABASE_URL=postgresql+psycopg://skyscout:skyscout@127.0.0.1:5432/skyscout_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

CORS_ORIGINS=["http://localhost:3000"]
# Must be true in production (HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=336
AUTH_RATE_LIMIT_PER_MINUTE=10

# Monitoring
MAX_ACTIVE_MONITORS_PER_USER=10
MONITOR_MIN_INTERVAL_MINUTES=60

# Email alerts: "console" (logs, recorded as simulated) or "smtp"
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SkyScout <alerts@example.invalid>
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:3000

# Flight providers. "demo" = synthetic data, no credentials needed.
# For real fares + booking via Aviasales affiliate links, set the two Travelpayouts values and use
#   ENABLED_PROVIDERS=["travelpayouts"]
# (Get them at travelpayouts.com → join the Aviasales program → API token and your partner ID/marker.)
ENABLED_PROVIDERS=["demo"]
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_REQUESTS_PER_MINUTE=60
TRAVELPAYOUTS_CACHE_TTL_S=10800
